#!/usr/bin/env bash
# interactive-review-launch — hand off to Neovim for an interactive code review.
#
# Async + durable. A review can run far longer than Claude Code's 10-minute
# Bash-tool cap, so `start` spawns the review and returns a handle immediately
# instead of blocking. The caller polls `status <handle>` (one-shot) or runs
# `wait <handle>` in the background to block until the review finishes.
#
# The review runs in a detached tmux session on its own explicit socket. That
# session is the durable supervisor and the source of truth for state: it
# outlives this script, the Ghostty window, and even Ghostty itself. The
# session's existence IS the running/finished state, so:
#   - closing the review window only DETACHES a client; the session survives and
#     is reattachable, and `wait` still completes when the review ends;
#   - if the session is killed without a submit (crash / forced close), `status`
#     and `wait` detect "aborted" promptly instead of hanging.
# An explicit `-S` socket gives that durable server a fixed address so every
# client (this script, the Ghostty window, your own terminal) reaches the same one.
#
# Subcommands:
#   start [<git-range>]      spawn the review; print a HANDLE on stdout, exit 0.
#                            No range defaults to HEAD~2..HEAD (override with
#                            CR_DEFAULT_RANGE); see resolve_range.
#   status <handle>          one-shot check: exit 3=running, 0=done (review JSON
#                            on stdout), 2=cancelled/aborted, 1/other=error
#   wait <handle> [interval] block, polling every <interval>s (default 1), until
#                            the review finishes; same completion semantics as
#                            status. Intended to be run in the background.
#   gc                       reap orphaned reviews (sessions/files/sockets left
#                            by a start that was never reaped). Runs
#                            automatically before each `start`; also runnable on
#                            demand or from cron/launchd.
#   <git-range> | (nothing)  legacy: start + wait in one blocking call (a
#                            missing range defaults to HEAD~2..HEAD)
#
# When the review reaches a terminal state, the Ghostty window, the tmux session,
# and the temp files are cleaned up. Anything missed (a start that was never
# waited on) is reaped by the next `start`'s sweep or an explicit `gc`.
#
# Exit codes (status / wait / legacy):
#   0  submitted (review JSON printed on stdout)
#   2  cancelled, or aborted (session ended without a submit)
#   1  error (diagnostic on stderr)
#   3  still running (status only)
#
# Dependencies: bash, tmux, jq, nvim (+ the neovim-code-review plugin).
# On macOS the review is surfaced in a new Ghostty window via AppleScript
# (osascript). If that fails, the script prints the `tmux -S … attach` command
# to run yourself.

set -euo pipefail

RUNNING_RC=3

# All per-review artifacts (result file, sentinel, state, tmux socket) live in
# one fixed directory so a sweep can find them regardless of $TMPDIR. Reviews
# older than CR_GC_MAX_AGE are reaped (abandoned, or a marathon beyond the wait
# ceiling); dead sockets are removed. Both are env-overridable.
WORKDIR="${CR_REVIEW_DIR:-/tmp/code-review-launch}"
GC_MAX_AGE="${CR_GC_MAX_AGE:-21600}" # 6h

# Reject git ranges with shell or Vim metacharacters; legitimate revision specs
# never contain `|`, `"`, `\`, or a newline, and each would break out of the
# `-c "CodeReview <range>"` invocation below.
reject_unsafe_range() {
  case "$1" in
    *[\|\"\\]*|*$'\n'*)
      printf 'interactive-review-launch: refusing unsafe argument: %s\n' "$1" >&2
      exit 1
      ;;
  esac
}

# Default git range when the caller passes none. A bare working-tree review
# includes untracked files (agent worktrees, scratch dirs) and is rarely what
# you want, so default to the last two commits (HEAD~2..HEAD). Override with
# CR_DEFAULT_RANGE. Falls back to the working tree only when HEAD~2 doesn't
# exist (a shallow or brand-new repo) or we're not in a git repo. Runs in the
# caller's cwd, i.e. the repo under review.
resolve_range() {
  local range="$1"
  [ -n "$range" ] && { printf '%s' "$range"; return; }
  if [ -n "${CR_DEFAULT_RANGE:-}" ]; then
    printf '%s' "$CR_DEFAULT_RANGE"
    return
  fi
  if git rev-parse --verify --quiet 'HEAD~2^{commit}' >/dev/null 2>&1; then
    printf 'HEAD~2..HEAD'
    return
  fi
  printf '' # too few commits / not a git repo -> working-tree review
}

# Spawn a review. Sets HANDLE (= the result-file path) and writes <handle>.state
# recording the tmux session and socket. Diagnostics go to stderr; nothing
# is written to stdout.
spawn_review() {
  local range
  range=$(resolve_range "${1:-}")
  reject_unsafe_range "$range"

  mkdir -p "$WORKDIR"
  chmod 700 "$WORKDIR" 2>/dev/null || true
  gc_sweep # reap orphans from past runs before starting a new review

  HANDLE=$(mktemp "$WORKDIR/review.XXXXXX")
  local base session sentinel sock
  base=$(basename "$HANDLE")
  # tmux treats `.` and `:` as target separators, so the session name must not
  # contain the mktemp suffix's dot; map any non-safe char to `-`.
  session="code-review-${base//[!A-Za-z0-9_]/-}"
  sentinel="$HANDLE.done"
  # Use a dedicated, explicit tmux socket so the session is created on the SAME
  # server the attach (Ghostty window, or a manual command) connects to. Without it,
  # when the launcher runs in an environment whose $TMUX / $TMUX_TMPDIR differs
  # from the attaching terminal's, the session lands on one server and `tmux
  # attach` looks at another -> "no sessions". The socket lives in the fixed
  # WORKDIR so both sides resolve the same path.
  sock="$WORKDIR/${session}.sock"

  # Neovim needs a real PTY, which Claude Code's Bash tool does not provide, so
  # run it inside a detached tmux session on our own socket. `env -u TMUX` keeps
  # it fully decoupled from any tmux the caller is already inside.
  if ! env -u TMUX tmux -S "$sock" new-session -d -s "$session" -x 220 -y 60 \
      "NVIM_CODE_REVIEW_RESULT='$HANDLE' nvim -c 'CodeReview $range'; echo \$? > '$sentinel'"; then
    printf 'interactive-review-launch: failed to start the review session\n' >&2
    rm -f "$HANDLE"
    exit 1
  fi

  # Surface the review in a new Ghostty tab (falling back to a window).
  # AppleScript is Ghostty's official automation interface. We run the attach via
  # the surface's `initial input` (typed into a normal login shell) with `exec`,
  # NOT the `command` property, for two reasons:
  #   - `command` runs in a bare shell (bash --noprofile --norc) with no Homebrew
  #     on $PATH, so `tmux` is not found;
  #   - Ghostty keeps an AppleScript `command`-surface open after the command
  #     exits (it ignores wait-after-command for these), so the tab would never
  #     close.
  # `exec` makes tmux the shell's process, so when the review ends and tmux
  # detaches the surface closes by ordinary shell-exit. `tmux_bin` is absolute so
  # it does not depend on the shell's aliases. The login shell has $PATH, so a
  # plain `tmux` would also resolve, but absolute is unambiguous.
  local tmux_bin attach
  tmux_bin=$(command -v tmux || echo tmux)
  attach="exec $tmux_bin -S $sock attach -t $session"
  if osascript -e "tell application \"Ghostty\" to new tab in front window with configuration {initial input:\"$attach\r\"}" >/dev/null 2>&1 \
     || osascript -e "tell application \"Ghostty\" to new window with configuration {initial input:\"$attach\r\"}" >/dev/null 2>&1; then
    printf 'Review opened in Ghostty (tmux session: %s).\n' "$session" >&2
  else
    printf 'Attach to the review with:  tmux -S %s attach -t %s\n' "$sock" "$session" >&2
  fi
  printf 'Submit with <leader>Rs, cancel with <leader>Rq.\n' >&2

  {
    printf 'started=%s\n' "$(date +%s)"
    printf 'session=%s\n' "$session"
    printf 'sock=%s\n' "$sock"
  } > "$HANDLE.state"
}

# Reap orphaned reviews: anything started more than GC_MAX_AGE ago (abandoned
# files/sockets, a session never reaped, or a marathon past the wait ceiling),
# plus dead sockets with no live server. Race-free: a review younger than
# GC_MAX_AGE is never touched, so an in-flight wait is never undercut.
gc_sweep() {
  local state handle started now s
  now=$(date +%s)
  for state in "$WORKDIR"/review.*.state; do
    [ -e "$state" ] || continue
    handle="${state%.state}"
    started=$(sed -n 's/^started=//p' "$state")
    if [ -z "$started" ] || [ $((now - started)) -gt "$GC_MAX_AGE" ]; then
      cleanup_review "$handle"
    fi
  done
  for s in "$WORKDIR"/*.sock; do
    [ -e "$s" ] || continue
    tmux -S "$s" list-sessions >/dev/null 2>&1 || rm -f "$s"
  done
}

# Read <handle>.state into STATE_SESSION / STATE_SOCK (empty if absent). Parsed
# line-by-line, never sourced.
read_state() {
  STATE_SESSION=""
  STATE_SOCK=""
  local k v
  [ -f "$1.state" ] || return 0
  while IFS='=' read -r k v; do
    case "$k" in
      session) STATE_SESSION="$v" ;;
      sock) STATE_SOCK="$v" ;;
    esac
  done < "$1.state"
}

# Is the durable review session still alive on its server?
session_alive() {
  [ -n "$STATE_SOCK" ] && [ -n "$STATE_SESSION" ] \
    && tmux -S "$STATE_SOCK" has-session -t "$STATE_SESSION" 2>/dev/null
}

# Tear down the review's tmux session and temp files. Idempotent. Killing the
# tmux session makes the attached `tmux attach` exit; because it was started with
# `exec` in the Ghostty tab's shell, the tab closes by ordinary shell-exit, so
# there is no Ghostty surface to close explicitly.
cleanup_review() {
  local handle="$1"
  read_state "$handle"
  [ -n "$STATE_SOCK" ] && [ -n "$STATE_SESSION" ] \
    && tmux -S "$STATE_SOCK" kill-session -t "$STATE_SESSION" 2>/dev/null || true
  rm -f "$handle" "$handle.done" "$handle.state"
  [ -n "$STATE_SOCK" ] && rm -f "$STATE_SOCK" || true
}

# One-shot poll. The durable tmux session is the source of truth for liveness:
#   - sentinel present            -> the command recorded an outcome; emit it
#   - no sentinel, session alive  -> still running (RUNNING_RC)
#   - no sentinel, session gone   -> aborted: Neovim/the tab was killed without
#                                    submitting (a closed tab only DETACHES, so
#                                    this means a real kill/crash, not a close)
# Emits the result (JSON on submit) and cleans up on any terminal state.
poll_once() {
  local handle="$1" sentinel="$1.done" rc review_path
  read_state "$handle"

  if [ ! -f "$sentinel" ]; then
    if session_alive; then
      return "$RUNNING_RC"
    fi
    # Session gone and nothing recorded. Brief grace for a teardown/write race
    # (the inner `echo $? > sentinel` completes just before the session ends),
    # then declare the review aborted.
    sleep 0.2
    if [ ! -f "$sentinel" ]; then
      printf 'review aborted: the session ended without submitting\n' >&2
      cleanup_review "$handle"
      return 2
    fi
  fi

  rc=$(cat "$sentinel" 2>/dev/null || echo 1)
  case "$rc" in
    0)
      review_path=$(cat "$handle" 2>/dev/null || true)
      if [ -z "$review_path" ] || [ ! -f "$review_path" ]; then
        printf 'interactive-review-launch: empty result file\n' >&2
        cleanup_review "$handle"
        return 1
      fi
      jq . "$review_path"
      cleanup_review "$handle"
      return 0
      ;;
    2)
      printf 'review cancelled\n' >&2
      cleanup_review "$handle"
      return 2
      ;;
    *)
      printf 'neovim error (exit %s)\n' "$rc" >&2
      cleanup_review "$handle"
      return "${rc:-1}"
      ;;
  esac
}

require_handle() {
  local handle="${1:-}"
  if [ -z "$handle" ] || [ ! -f "$handle.state" ]; then
    printf 'interactive-review-launch: unknown review handle: %s\n' "${handle:-<none>}" >&2
    exit 1
  fi
}

do_start() {
  spawn_review "${1:-}"
  printf '%s\n' "$HANDLE" # the handle: pass to `status` / `wait`
}

do_status() {
  require_handle "${1:-}"
  local rc=0
  poll_once "$1" || rc=$?
  if [ "$rc" = "$RUNNING_RC" ]; then
    printf 'running\n' >&2
  fi
  exit "$rc"
}

# Block until the review finishes, polling every <interval>s. Exits with the
# review's code.
poll_loop() {
  local handle="$1" interval="${2:-1}" start now max_wait=18000 rc
  start=$(date +%s)
  while true; do
    rc=0
    poll_once "$handle" || rc=$?
    if [ "$rc" != "$RUNNING_RC" ]; then
      exit "$rc"
    fi
    sleep "$interval"
    now=$(date +%s)
    if [ $((now - start)) -gt $max_wait ]; then
      printf 'interactive-review-launch: timed out after %d seconds\n' "$max_wait" >&2
      cleanup_review "$handle"
      exit 1
    fi
  done
}

do_wait() {
  require_handle "${1:-}"
  poll_loop "$1" "${2:-1}"
}

do_legacy() {
  # Backward-compatible blocking mode: spawn, then poll in this process. A trap
  # tidies up on Ctrl-C / kill (poll_once already cleans up on completion).
  spawn_review "${1:-}"
  trap 'cleanup_review "$HANDLE"' EXIT INT TERM HUP
  poll_loop "$HANDLE" 0.5
}

do_gc() {
  mkdir -p "$WORKDIR" 2>/dev/null || true
  gc_sweep
  printf 'gc: swept reviews older than %ss in %s\n' "$GC_MAX_AGE" "$WORKDIR" >&2
}

cmd="${1:-}"
case "$cmd" in
  start)
    shift
    do_start "${1:-}"
    ;;
  status)
    shift
    do_status "${1:-}"
    ;;
  wait)
    shift
    do_wait "${1:-}" "${2:-1}"
    ;;
  gc)
    do_gc
    ;;
  *)
    do_legacy "${1:-}"
    ;;
esac
