#!/usr/bin/env bash
# interactive-review-launch — hand off to Neovim for an interactive code review.
#
# Async + durable. A review can run far longer than Claude Code's 10-minute
# Bash-tool cap, so `start` spawns the review and returns a handle immediately
# instead of blocking. The caller polls `status <handle>` (one-shot) or runs
# `wait <handle>` in the background to block until the review finishes.
#
# The review runs in a detached zmx session. That session is the durable
# supervisor and the source of truth for state: it outlives this script and the
# kitty window that displays it. The session's existence IS the running state:
#   - closing the review window only DETACHES the zmx client; the session
#     survives, is reattachable (`zmx attach <session>`), and `wait` still
#     completes when the review ends;
#   - if the session is killed without a submit (crash / forced kill), `status`
#     and `wait` detect "aborted" promptly instead of hanging.
#
# Subcommands:
#   start [<git-range>]      spawn the review; print a HANDLE on stdout, exit 0.
#                            No range defaults to HEAD~2..HEAD (override with
#                            CR_DEFAULT_RANGE); see resolve_range.
#   status <handle>          one-shot check: exit 3=running, 0=done (review JSON
#                            on stdout), 2=cancelled/aborted, 1/other=error
#   wait <handle> [interval] block, polling every <interval>s (default 1), until
#                            the review finishes; same completion semantics as
#                            status. Intended to be run in the background.
#   gc                       reap orphaned reviews (sessions/files left by a
#                            start that was never reaped). Runs automatically
#                            before each `start`; also runnable on demand.
#   <git-range> | (nothing)  legacy: start + wait in one blocking call (a
#                            missing range defaults to HEAD~2..HEAD)
#
# When the review reaches a terminal state, the zmx session and the temp files
# are cleaned up; killing the session closes any kitty window attached to it.
# Anything missed is reaped by the next `start`'s sweep or an explicit `gc`.
#
# Exit codes (status / wait / legacy):
#   0  submitted (review JSON printed on stdout)
#   2  cancelled, or aborted (session ended without a submit)
#   1  error (diagnostic on stderr)
#   3  still running (status only)
#
# Dependencies: bash, zmx, jq, nvim (+ the neovim-code-review plugin).
# On macOS the review is surfaced as a focused kitty tab via `kitten @` remote
# control (the review is an interactive handoff the user works in, so it gets
# a tab, not a background split). If kitty is unreachable, the script prints
# the `zmx attach` command to run yourself.

set -euo pipefail

RUNNING_RC=3
ZMX="${CR_ZMX_BIN:-/opt/homebrew/bin/zmx}"
KITTEN="${CR_KITTEN_BIN:-/Applications/kitty.app/Contents/MacOS/kitten}"

# Inside a ccd container there is no host zmx/kitty/nvim. IS_SANDBOX is set in
# every ccd container. In that mode `start` does not spawn anything: it writes
# a request into the shared /ccd-state/review dir and the ccd dashboard opens
# the review tab (nvim runs in this container via `container exec`, writing its
# result and the sentinel back into the same dir). `wait` polls those files.
SANDBOX="${IS_SANDBOX:-}"

# All per-review artifacts (result file, sentinel, state) live in one fixed
# directory so a sweep can find them regardless of $TMPDIR. Reviews older than
# CR_GC_MAX_AGE are reaped (abandoned, or a marathon beyond the wait ceiling).
# Both are env-overridable.
if [ -n "$SANDBOX" ]; then
  WORKDIR="${CR_REVIEW_DIR:-/ccd-state/review}"
else
  WORKDIR="${CR_REVIEW_DIR:-/tmp/code-review-launch}"
fi
GC_MAX_AGE="${CR_GC_MAX_AGE:-21600}" # 6h

# Reject git ranges with shell or Vim metacharacters; legitimate revision specs
# never contain `|`, `"`, `\`, or a newline, and each would break out of the
# `-c "CodeReview <range>"` invocation below.
reject_unsafe_range() {
  case "$1" in
    *[\|\"\\]*|*$'\n'*)
      printf 'interactive-review-launch: refusing unsafe argument: %s\n' "$1" >&2
      exit 1
      ;;
  esac
}

# Default git range when the caller passes none. A bare working-tree review
# includes untracked files (agent worktrees, scratch dirs) and is rarely what
# you want, so default to the last two commits (HEAD~2..HEAD). Override with
# CR_DEFAULT_RANGE. Falls back to the working tree only when HEAD~2 doesn't
# exist (a shallow or brand-new repo) or we're not in a git repo. Runs in the
# caller's cwd, i.e. the repo under review.
resolve_range() {
  local range="$1"
  [ -n "$range" ] && { printf '%s' "$range"; return; }
  if [ -n "${CR_DEFAULT_RANGE:-}" ]; then
    printf '%s' "$CR_DEFAULT_RANGE"
    return
  fi
  if git rev-parse --verify --quiet 'HEAD~2^{commit}' >/dev/null 2>&1; then
    printf 'HEAD~2..HEAD'
    return
  fi
  printf '' # too few commits / not a git repo -> working-tree review
}

# The kitty remote-control socket: prefer the exact instance hosting this
# session (KITTY_PID is exported inside every kitty window), fall back to the
# newest socket. Empty output means no kitty to talk to.
kitty_sock() {
  if [ -n "${KITTY_PID:-}" ] && [ -e "/tmp/kitty-$KITTY_PID" ]; then
    printf 'unix:/tmp/kitty-%s' "$KITTY_PID"
    return
  fi
  local s
  s=$(ls -t /tmp/kitty-[0-9]* 2>/dev/null | head -1 || true)
  [ -n "$s" ] && printf 'unix:%s' "$s"
}

# Spawn a review. Sets HANDLE (= the result-file path) and writes <handle>.state
# recording the zmx session name. Diagnostics go to stderr; nothing is written
# to stdout.
spawn_review() {
  local range
  range=$(resolve_range "${1:-}")
  reject_unsafe_range "$range"

  mkdir -p "$WORKDIR"
  chmod 700 "$WORKDIR" 2>/dev/null || true
  gc_sweep # reap orphans from past runs before starting a new review

  HANDLE=$(mktemp "$WORKDIR/review.XXXXXX")
  local base session sentinel
  base=$(basename "$HANDLE")
  session="code-review-${base//[!A-Za-z0-9_]/-}"
  sentinel="$HANDLE.done"

  if [ -n "$SANDBOX" ]; then
    # Hand the review to the host over the ccd bridge. It opens nvim in this
    # container (via `container exec`) with NVIM_CODE_REVIEW_RESULT pointing
    # back at $HANDLE, so the result lands here for poll_once to read. The
    # bridge call blocks until the tab is up (or fails), so no local
    # zmx/kitty/nvim is touched.
    printf 'started=%s\nsession=%s\n' "$(date +%s)" "$session" > "$HANDLE.state"
    if ! ccd-bridge review "$base" "$range"; then
      printf 'review failed to open on the host\n' >&2
      cleanup_review "$HANDLE"
      exit 1
    fi
    printf 'Review opened on the host.\n' >&2
    return
  fi

  # Record the state BEFORE creating the session: every session that ever
  # exists is then named by a state file from birth, so the age-based gc can
  # always reap it. Writing state second would leave an unreapable session if
  # this script died in between (the zmx replacement for the old dead-socket
  # sweep).
  {
    printf 'started=%s\n' "$(date +%s)"
    printf 'session=%s\n' "$session"
  } > "$HANDLE.state"

  # Neovim needs a real PTY, which Claude Code's Bash tool does not provide, so
  # run it inside a detached zmx session. `zmx run <name> -d` creates the
  # session (a login shell in the caller's cwd, i.e. the repo) and types the
  # command at its prompt; the sentinel records nvim's exit code the moment it
  # exits, independent of any attached viewer. zmx restores the display via
  # libghostty-vt and passes truecolor through, so no terminal-features
  # ceremony is needed.
  if ! "$ZMX" run "$session" -d sh -c "NVIM_CODE_REVIEW_RESULT='$HANDLE' nvim -c 'CodeReview $range'; echo \$? > '$sentinel'" >/dev/null 2>&1; then
    printf 'interactive-review-launch: failed to start the review session\n' >&2
    cleanup_review "$HANDLE"
    exit 1
  fi

  # Surface the review as a FOCUSED kitty tab: this is an interactive handoff
  # (the user reviews in nvim), so it takes a tab and takes focus — unlike
  # background tasks, which surface as --keep-focus splits. Killing the zmx
  # session later closes the attached tab automatically. If kitty is
  # unreachable, the session still runs; print the manual attach command.
  local sock
  sock=$(kitty_sock)
  if [ -n "$sock" ] \
     && "$KITTEN" @ --to "$sock" launch --type=tab --tab-title "review" \
          "$ZMX" attach "$session" >/dev/null 2>&1; then
    printf 'Review opened in a kitty tab (zmx session: %s).\n' "$session" >&2
    # The attach resizes the session PTY, but nvim's screen was restored
    # from pre-attach geometry and can leave stale rows (e.g. the file
    # tree's top line) until a full repaint. Nudge it with Ctrl+L once the
    # resize has settled; harmless if already clean.
    ( sleep 1; printf '\x0c' | "$ZMX" send "$session" ) >/dev/null 2>&1 &
  else
    printf 'Attach to the review with:  zmx attach %s\n' "$session" >&2
  fi
  printf 'Submit with <leader>Rs, cancel with <leader>Rq.\n' >&2
}

# Reap orphaned reviews: anything started more than GC_MAX_AGE ago (abandoned
# files, a session never reaped, or a marathon past the wait ceiling).
# Race-free: a review younger than GC_MAX_AGE is never touched, so an in-flight
# wait is never undercut.
gc_sweep() {
  local state handle started now
  now=$(date +%s)
  for state in "$WORKDIR"/review.*.state; do
    [ -e "$state" ] || continue
    handle="${state%.state}"
    started=$(sed -n 's/^started=//p' "$state")
    if [ -z "$started" ] || [ $((now - started)) -gt "$GC_MAX_AGE" ]; then
      cleanup_review "$handle"
    fi
  done
}

# Read <handle>.state into STATE_SESSION (empty if absent). Parsed
# line-by-line, never sourced.
read_state() {
  STATE_SESSION=""
  local k v
  [ -f "$1.state" ] || return 0
  while IFS='=' read -r k v; do
    case "$k" in
      session) STATE_SESSION="$v" ;;
    esac
  done < "$1.state"
}

# Is the durable review session still alive?
session_alive() {
  [ -n "$STATE_SESSION" ] \
    && "$ZMX" list --short 2>/dev/null | grep -Fxq "$STATE_SESSION"
}

# Tear down the review's zmx session and temp files. Idempotent. Killing the
# session terminates any attached client, so a kitty tab showing the review
# closes by itself; there is no window bookkeeping.
cleanup_review() {
  local handle="$1"
  read_state "$handle"
  # No local zmx session in a sandbox; only the host owns the review tab.
  [ -z "$SANDBOX" ] && [ -n "$STATE_SESSION" ] \
    && "$ZMX" kill "$STATE_SESSION" --force >/dev/null 2>&1 || true
  rm -f "$handle" "$handle.done" "$handle.state" "$handle.error" "$handle.opened"
}

# One-shot poll. The durable zmx session is the source of truth for liveness:
#   - sentinel present            -> the command recorded an outcome; emit it
#   - no sentinel, session alive  -> still running (RUNNING_RC)
#   - no sentinel, session gone   -> aborted: nvim/the session was killed
#                                    without submitting (closing the kitty tab
#                                    only DETACHES, so this means a real
#                                    kill/crash, not a close)
# Emits the result (JSON on submit) and cleans up on any terminal state.
poll_once() {
  local handle="$1" sentinel="$1.done" rc review_path
  read_state "$handle"

  if [ -n "$SANDBOX" ]; then
    # The host already confirmed the tab opened (the bridge call in
    # spawn_review blocked on that). Liveness is just the sentinel: nvim's exit
    # code reaches it via the `container exec` wrapper (including the
    # VimLeavePre 2 on a close without submit), so an abort is seen here too.
    if [ ! -f "$sentinel" ]; then
      return "$RUNNING_RC"
    fi
  elif [ ! -f "$sentinel" ]; then
    if session_alive; then
      return "$RUNNING_RC"
    fi
    # Session gone and nothing recorded. Brief grace for a teardown/write race
    # (the inner `echo $? > sentinel` completes just before the session ends),
    # then declare the review aborted.
    sleep 0.2
    if [ ! -f "$sentinel" ]; then
      printf 'review aborted: the session ended without submitting\n' >&2
      cleanup_review "$handle"
      return 2
    fi
  fi

  rc=$(cat "$sentinel" 2>/dev/null || echo 1)
  case "$rc" in
    0)
      review_path=$(cat "$handle" 2>/dev/null || true)
      if [ -z "$review_path" ] || [ ! -f "$review_path" ]; then
        printf 'interactive-review-launch: empty result file\n' >&2
        cleanup_review "$handle"
        return 1
      fi
      jq . "$review_path"
      cleanup_review "$handle"
      return 0
      ;;
    2)
      printf 'review cancelled\n' >&2
      cleanup_review "$handle"
      return 2
      ;;
    *)
      printf 'neovim error (exit %s)\n' "$rc" >&2
      cleanup_review "$handle"
      return "${rc:-1}"
      ;;
  esac
}

require_handle() {
  local handle="${1:-}"
  if [ -z "$handle" ] || [ ! -f "$handle.state" ]; then
    printf 'interactive-review-launch: unknown review handle: %s\n' "${handle:-<none>}" >&2
    exit 1
  fi
}

do_start() {
  spawn_review "${1:-}"
  printf '%s\n' "$HANDLE" # the handle: pass to `status` / `wait`
}

do_status() {
  require_handle "${1:-}"
  local rc=0
  poll_once "$1" || rc=$?
  if [ "$rc" = "$RUNNING_RC" ]; then
    printf 'running\n' >&2
  fi
  exit "$rc"
}

# Block until the review finishes, polling every <interval>s. Exits with the
# review's code.
poll_loop() {
  local handle="$1" interval="${2:-1}" start now max_wait=18000 rc
  start=$(date +%s)
  while true; do
    rc=0
    poll_once "$handle" || rc=$?
    if [ "$rc" != "$RUNNING_RC" ]; then
      exit "$rc"
    fi
    sleep "$interval"
    now=$(date +%s)
    if [ $((now - start)) -gt $max_wait ]; then
      printf 'interactive-review-launch: timed out after %d seconds\n' "$max_wait" >&2
      cleanup_review "$handle"
      exit 1
    fi
  done
}

do_wait() {
  require_handle "${1:-}"
  poll_loop "$1" "${2:-1}"
}

do_legacy() {
  # Backward-compatible blocking mode: spawn, then poll in this process. A trap
  # tidies up on Ctrl-C / kill (poll_once already cleans up on completion).
  spawn_review "${1:-}"
  trap 'cleanup_review "$HANDLE"' EXIT INT TERM HUP
  poll_loop "$HANDLE" 0.5
}

do_gc() {
  mkdir -p "$WORKDIR" 2>/dev/null || true
  gc_sweep
  printf 'gc: swept reviews older than %ss in %s\n' "$GC_MAX_AGE" "$WORKDIR" >&2
}

cmd="${1:-}"
case "$cmd" in
  start)
    shift
    do_start "${1:-}"
    ;;
  status)
    shift
    do_status "${1:-}"
    ;;
  wait)
    shift
    do_wait "${1:-}" "${2:-1}"
    ;;
  gc)
    do_gc
    ;;
  *)
    do_legacy "${1:-}"
    ;;
esac
